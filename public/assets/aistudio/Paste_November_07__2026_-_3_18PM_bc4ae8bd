## 5. Peer-to-Peer Mesh Networking Layer

Implement `NearbyConnectionsMeshManager.kt` using Google Nearby Connections with `Strategy.P2P_CLUSTER`. This enables ad-hoc, multi-peer mesh clusters without internet access.

### 5.1 Mesh Manager (`network/NearbyConnectionsMeshManager.kt`)

```kotlin
package com.silentbeacon.network

import android.content.Context
import com.google.android.gms.nearby.Nearby
import com.google.android.gms.nearby.connection.*
import com.silentbeacon.data.model.*
import kotlinx.coroutines.*
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.serialization.encodeToString
import kotlinx.serialization.json.Json
import java.nio.charset.StandardCharsets

class NearbyConnectionsMeshManager(
    private val context: Context,
    private val localNodeId: String,
    private val onPayloadReceivedListener: suspend (MeshPayload, String) -> Unit
) {
    private val client = Nearby.getConnectionsClient(context)
    private val scope = CoroutineScope(Dispatchers.IO + SupervisorJob())
    private val serviceId = "com.silentbeacon.mesh.v1"

    private val _connectedPeers = MutableStateFlow<Set<String>>(emptySet())
    val connectedPeers: StateFlow<Set<String>> = _connectedPeers

    fun startMesh() {
        startAdvertising()
        startDiscovery()
    }

    fun stopMesh() {
        client.stopAdvertising()
        client.stopDiscovery()
        client.stopAllEndpoints()
        _connectedPeers.value = emptySet()
    }

    private fun startAdvertising() {
        val advertisingOptions = AdvertisingOptions.Builder()
            .setStrategy(Strategy.P2P_CLUSTER)
            .build()

        client.startAdvertising(localNodeId, serviceId, connectionLifecycleCallback, advertisingOptions)
    }

    private fun startDiscovery() {
        val discoveryOptions = DiscoveryOptions.Builder()
            .setStrategy(Strategy.P2P_CLUSTER)
            .build()

        client.startDiscovery(serviceId, endpointDiscoveryCallback, discoveryOptions)
    }

    private val endpointDiscoveryCallback = object : EndpointDiscoveryCallback() {
        override fun onEndpointFound(endpointId: String, info: DiscoveredEndpointInfo) {
            // Auto-initiate connection with discovered peers
            client.requestConnection(localNodeId, endpointId, connectionLifecycleCallback)
        }
        override fun onEndpointLost(endpointId: String) {}
    }

    private val connectionLifecycleCallback = object : ConnectionLifecycleCallback() {
        override fun onConnectionInitiated(endpointId: String, connectionInfo: ConnectionInfo) {
            // Unattended, zero-friction pairing for emergency response
            client.acceptConnection(endpointId, payloadCallback)
        }

        override fun onConnectionResult(endpointId: String, result: ConnectionResolution) {
            if (result.status.isSuccess) {
                _connectedPeers.value = _connectedPeers.value + endpointId
            } else {
                _connectedPeers.value = _connectedPeers.value - endpointId
            }
        }

        override fun onDisconnected(endpointId: String) {
            _connectedPeers.value = _connectedPeers.value - endpointId
        }
    }

    private val payloadCallback = object : PayloadCallback() {
        override fun onPayloadReceived(endpointId: String, payload: Payload) {
            if (payload.type == Payload.Type.BYTES) {
                payload.asBytes()?.let { bytes ->
                    val jsonStr = String(bytes, StandardCharsets.UTF_8)
                    scope.launch {
                        try {
                            val decoded = Json.decodeFromString<MeshPayload>(jsonStr)
                            onPayloadReceivedListener(decoded, endpointId)
                        } catch (e: Exception) {
                            // Suppress invalid malformed gossip packets
                        }
                    }
                }
            }
        }
        override fun onPayloadTransferUpdate(endpointId: String, update: PayloadTransferUpdate) {}
    }

    suspend fun sendPayload(endpointId: String, payload: MeshPayload) = withContext(Dispatchers.IO) {
        val jsonStr = Json.encodeToString(payload)
        val bytes = jsonStr.toByteArray(StandardCharsets.UTF_8)
        client.sendPayload(endpointId, Payload.fromBytes(bytes))
    }

    suspend fun broadcastPayload(payload: MeshPayload) = withContext(Dispatchers.IO) {
        val targets = _connectedPeers.value.toList()
        if (targets.isNotEmpty()) {
            val jsonStr = Json.encodeToString(payload)
            val bytes = jsonStr.toByteArray(StandardCharsets.UTF_8)
            client.sendPayload(targets, Payload.fromBytes(bytes))
        }
    }
}

