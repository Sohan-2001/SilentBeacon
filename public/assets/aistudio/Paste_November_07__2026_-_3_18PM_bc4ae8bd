package com.silentbeacon.data.local

import androidx.room.*
import com.silentbeacon.data.model.EmergencyTicket
import com.silentbeacon.data.model.TicketStatus
import kotlinx.coroutines.flow.Flow

@Dao
interface TicketDao {
